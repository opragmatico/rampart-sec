# Copy to .env and fill in. Never commit .env.

# ── required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
RAMPART_AUTH_TOKEN=change-me            # bearer token for /v1/* and /mcp (the service refuses to start without it)

# ── optional providers ────────────────────────────────────────────────────────
OPENAI_BASE_URL=                        # an OpenAI-compatible proxy
TAVILY_API_KEY=                         # search_advisories returns a NOT_CONFIGURED error without it
NVD_API_KEY=                            # raises the NVD rate limit from 5 to 50 requests per 30 s

# ── service ───────────────────────────────────────────────────────────────────
# RAMPART_HOST=127.0.0.1
# RAMPART_PORT=8765
# RAMPART_MAX_CONCURRENT_RUNS=4         # agent runs served at once
# RAMPART_COMPANY=Larkspur Logistics    # the company the agent answers for
# RAMPART_LOG_FORMAT=console            # console | json
# RAMPART_LOG_LEVEL=INFO

# ── models ────────────────────────────────────────────────────────────────────
# RAMPART_AGENT_MODEL=gpt-4o-mini
# RAMPART_SCORER_MODEL=gpt-4o-mini      # assess_urgency and the document answerer
# RAMPART_CLASSIFIER_MODEL=gpt-4o-mini  # input guard, layer 2
# RAMPART_JUDGE_MODEL=gpt-4o            # output guard, layer 2: a stronger judge than the agent model
# RAMPART_EMBEDDING_MODEL=text-embedding-3-small

# ── retrieval ─────────────────────────────────────────────────────────────────
# QDRANT_URL=http://localhost:6333      # unset -> Qdrant local mode under var/qdrant
# QDRANT_API_KEY=
# RAMPART_RETRIEVAL_K=10

# ── guardrails ────────────────────────────────────────────────────────────────
# RAMPART_INJECTION_THRESHOLD=0.70      # signature layer; calibrated with `rampart eval guardrail`
# RAMPART_TOOL_GUARD_THRESHOLD=0.70
# RAMPART_OVERLAP_THRESHOLD=0.35        # share of answer 10-grams found verbatim in retrieved chunks

# ── tickets ───────────────────────────────────────────────────────────────────
# RAMPART_TICKET_BACKEND=sqlite         # sqlite | github
# RAMPART_GITHUB_REPO=owner/name
# GITHUB_TOKEN=

# ── development ───────────────────────────────────────────────────────────────
# RAMPART_HTTP_MODE=live                # live | record | replay (cassettes under tests/cassettes)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
